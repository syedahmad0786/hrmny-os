{
  "name": "hrmny-os",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build --concurrency=1",
    "lint": "turbo run lint",
    "test": "turbo run test --concurrency=1",
    "typecheck": "turbo run typecheck",
    "e2e": "pnpm --filter @hrmny/web e2e",
    "e2e:bridge": "pnpm --dir apps/web exec tsx e2e/local-bridge-server.ts",
    "db:generate": "pnpm --filter @hrmny/db generate",
    "db:migrate": "pnpm --filter @hrmny/db migrate",
    "db:verify": "pnpm --filter @hrmny/db verify:migrations",
    "db:studio": "pnpm --filter @hrmny/db studio"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.10",
      "@types/react-dom": "19.0.4"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "15.5.20",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^2.1.8"
  }
}
