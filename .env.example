# Names only — never commit secret values.
# See hrmny_OS_Execution/04-PACKAGE-MANIFEST.md §5

# App / Vercel
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_PORTAL_URL=

NODE_ENV=development

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Preferred for new projects; legacy anon key remains supported during migration.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Prefer the modern secret key; legacy service_role is a fallback.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=

# Auth (often configured in Supabase dashboard)
# dev = header x-dev-role personas (default when no Supabase URL)
# supabase = live Supabase Auth (Google SSO / magic link)
AUTH_MODE=dev
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
SUPABASE_JWT_SECRET=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Upstash Redis — hot-path cache / rate limits (@hrmny/cache)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# LLM — mock returns structured invoice propose payloads without keys
LLM_PROVIDER=mock
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Embeddings for memory_chunk (pgvector) — server only
OPENAI_API_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_BASE_URL=
LLM_DEFAULT_MODEL=
LLM_REASONING_MODEL=
LLM_ROUTE_MODEL=
LLM_MONTHLY_CAP_AED=

# Composio
COMPOSIO_API_KEY=
COMPOSIO_WEBHOOK_SECRET=

# Direct integrations
# XERO_MODE=mock (default) | live — live without keys fails loud
XERO_MODE=mock
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=
XERO_WEBHOOK_KEY=
# Apollo / Hunter — mock by default for M3 demos without keys
APOLLO_MODE=mock
APOLLO_API_KEY=
HUNTER_MODE=mock
HUNTER_API_KEY=
NEVERBOUNCE_API_KEY=
# BAYZAT_SOURCE=csv (default fallback) | api
BAYZAT_SOURCE=csv
BAYZAT_API_KEY=
BAYZAT_API_BASE_URL=
# n8n — hrmny OS Cloud instance only (NOT personal ahmadbukhari.app)
# Base URL has no trailing slash. Keys never in git — see 11-N8N-SETUP.md
N8N_BASE_URL=https://hrmny.app.n8n.cloud
N8N_API_KEY=
N8N_MODE=mock
# Explicit allow for live webhook fires (HITL / ops). Default false.
N8N_ALLOW_PRODUCTION_TRIGGER=false
N8N_WEBHOOK_SECRET=
GOOGLE_CHAT_WEBHOOK_URL=
TEJARI_CREDENTIALS=

# Storage / DAM
# DAM_STORAGE=memory (default) | supabase — supabase fails loud without URL+service role
DAM_STORAGE=memory
DAM_BUCKET=hrmny-dam
DAM_SIGNED_URL_TTL_SECONDS=300

# Ops
SENTRY_DSN=
LOG_LEVEL=info

# M1 demo waiver notes (not secrets):
# AUTH_MODE=dev is accepted for payment demo with partner sign-off until Google SSO is live.
# GOOGLE_CHAT_WEBHOOK_URL empty → health signals recorded in-app only (stub).
# Set webhook URL to POST live Chat alerts.
