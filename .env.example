# Names only — never commit secret values.
# Fill from Keeper → copy to .env.local / Vercel.
# See docs/BUILD-ACCESS-INVENTORY.md and docs/CREDENTIALS-NEEDED.md

# App / Vercel
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_PORTAL_URL=

NODE_ENV=development

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Preferred for new projects; legacy anon key remains supported during migration.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Prefer the modern secret key; legacy service_role is a fallback.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=

# Work environment identity and optional isolated sandbox deployment.
WORK_ENVIRONMENT_KIND=production
WORK_ENVIRONMENT_ID=hrmny-production
WORK_ENVIRONMENT_VERIFICATION_TOKEN=
WORK_SANDBOX_BASE_URL=
WORK_SANDBOX_VERIFICATION_TOKEN=
# Set only in the separately deployed sandbox after verifying its database.
WORK_SANDBOX_ALLOW_RESET=false

# Auth (often configured in Supabase dashboard)
# dev = header x-dev-role personas (default when no Supabase URL)
# supabase = live Supabase Auth (Google SSO / magic link)
AUTH_MODE=dev
# Production always uses supabase. Dev header personas require this explicit allow.
ALLOW_DEV_AUTH=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Same Google Cloud client as refresh. Production:
# https://hrmny-os.vercel.app/api/integrations/google-workspace/callback
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_WORKSPACE_REDIRECT_URI=
# Dedicated HMAC secret (32+ chars); never reuse CRON/JWT/Xero secrets.
GOOGLE_OAUTH_STATE_SECRET=
SUPABASE_JWT_SECRET=

# Inngest route/functions are wired locally; these references activate cloud sync.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Upstash Redis — hot-path cache / rate limits (@hrmny/cache)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# LLM — mock returns structured payloads without keys
# General workspace (day-to-day agents). Never put salaries/finance in this key.
LLM_PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_WORKSPACE_ID=
# Privileged workspace — salaries / financials only (separate OpenRouter workspace + key)
OPENROUTER_PRIVILEGED_API_KEY=
OPENROUTER_PRIVILEGED_WORKSPACE_ID=
ANTHROPIC_API_KEY=
# Embeddings for memory_chunk (pgvector) — server only. none|openai|openrouter|local
OPENAI_API_KEY=
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=text-embedding-3-small
# Local hash vectors are demo-only and require both settings explicitly.
ALLOW_LOCAL_EMBEDDINGS=false
# Alias consumed by memory-db (falls back to EMBEDDING_MODEL)
LLM_EMBED_MODEL=
LLM_IMAGE_MODEL=
# Comma-separated agent ids to disable (kill switch)
AGENT_DISABLED_LIST=
OLLAMA_BASE_URL=
# Prefer a free OpenRouter route for demos (content-bearing).
# Default: stealth/ox-alpha. Alternatives: liquid/lfm-2.5-2.6b:free, openrouter/free
LLM_DEFAULT_MODEL=stealth/ox-alpha
LLM_REASONING_MODEL=
LLM_ROUTE_MODEL=
LLM_MONTHLY_CAP_AED=1500

# Composio (deferred this phase)
COMPOSIO_API_KEY=
COMPOSIO_WEBHOOK_SECRET=

# Direct integrations
# XERO_MODE=mock (default) | live — live without keys fails loud
# Client lock (14 Aug 2026): OS reads/mirrors Xero only — never writes.
XERO_MODE=mock
XERO_WRITE_ENABLED=false
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=
XERO_WEBHOOK_KEY=
# Dedicated HMAC secret (32+ chars); never reuse CRON/JWT/Google secrets.
XERO_OAUTH_STATE_SECRET=
# Legal identifier; when empty, invoice issue remains at unknown_held.
HRMNY_TAX_REGISTRATION_NUMBER=
# Optional pre-authorized token (Keeper / Vault). Prefer OAuth callback persistence.
XERO_ACCESS_TOKEN=
XERO_TENANT_ID=
# Credentials connect; explicit live mode activates; paid calls need a separate
# owner-approved billing flag. Keep these false until a credit cap is approved.
APOLLO_MODE=mock
APOLLO_API_KEY=
APOLLO_ALLOW_PAID_OPERATIONS=false
HUNTER_MODE=mock
HUNTER_API_KEY=
HUNTER_ALLOW_PAID_OPERATIONS=false
# Decoupled from Hunter. neverbounce live uses NEVERBOUNCE_MODE + NEVERBOUNCE_API_KEY.
EMAIL_VERIFICATION_PROVIDER=hunter
NEVERBOUNCE_MODE=mock
NEVERBOUNCE_API_KEY=
NEVERBOUNCE_ALLOW_PAID_OPERATIONS=false
# Optional daily competitor list for the cron sweeper (comma-separated)
LEADGEN_COMPETITORS=
# Read-only ads insights stay mock until an approved M11 scope
ADS_INSIGHTS_MODE=mock
ADS_INSIGHTS_PLATFORM=meta
# Transactional email (portal magic-link / scheduled reports)
RESEND_MODE=mock
RESEND_API_KEY=
RESEND_FROM=
# BAYZAT_SOURCE=csv is the only verified bridge; api fails loud until tenant docs exist.
BAYZAT_SOURCE=csv
# Reserved references; a key alone does not activate an unverified API contract.
BAYZAT_API_KEY=
BAYZAT_API_BASE_URL=
# n8n — hrmny OS Cloud instance only (NOT personal ahmadbukhari.app)
# Base URL has no trailing slash. Keys never in git
N8N_BASE_URL=https://hrmny.app.n8n.cloud
N8N_API_KEY=
N8N_MODE=mock
# Explicit allow for live webhook fires (HITL / ops). Default false.
N8N_ALLOW_PRODUCTION_TRIGGER=false
# Header Auth value for OS -> n8n webhook calls (`X-Hrmny-Os-Secret`).
N8N_OUTBOUND_WEBHOOK_SECRET=
# Independent credential for n8n -> OS callbacks.
N8N_WEBHOOK_SECRET=
# Alias accepted by inbound/n8n receivers
HRMNY_N8N_WEBHOOK_SECRET=
# Receivers fail closed in every environment; CRON_SECRET is never a fallback.
GOOGLE_CHAT_WEBHOOK_URL=
# Google Chat app interaction endpoint. Store the service-account JSON as one
# Vercel secret; it is used only for chat.bot asynchronous replies.
GOOGLE_CHAT_AUDIENCE=https://hrmny-os.vercel.app/api/integrations/google-chat/events
GOOGLE_CHAT_SERVICE_ACCOUNT_JSON=
# Dedicated GBrain v0.48.2.0 / 5cfb84f runtime. The token's write source must
# be bound server-side to the hrmny/knowledge/ slug prefix.
GBRAIN_MCP_URL=
GBRAIN_ACCESS_TOKEN=
GBRAIN_SOURCE_ID=hrmny-os
TEJARI_CREDENTIALS=

# Storage / DAM
# DAM_STORAGE=memory (default) | supabase — supabase fails loud without URL+service role
DAM_STORAGE=memory
DAM_BUCKET=hrmny-dam
DAM_SIGNED_URL_TTL_SECONDS=300

# Ops
SENTRY_DSN=
# Public DSN used by browser error capture (DSNs are identifiers, not auth tokens).
NEXT_PUBLIC_SENTRY_DSN=
LOG_LEVEL=info
CRON_SECRET=

# Feature flags (production daily OS)
# Hide ESS / benefits / workplace / digital-card surfaces unless explicitly enabled
FEATURE_MINIMAL_HR=true
FEATURE_SHOW_ESS=false
FEATURE_SHOW_BENEFITS=false
FEATURE_SHOW_WORKPLACE=false
FEATURE_SHOW_DIGITAL_CARDS=false
FEATURE_SHOW_DEMO_RESETS=false

# M1 readiness notes (not secrets):
# Production requires AUTH_MODE=supabase and a connected Google Workspace account.
# GOOGLE_CHAT_WEBHOOK_URL empty means the M1 alerting acceptance criterion is not met.
# XERO_WRITE_ENABLED must stay false unless a new scoped engagement overrides the client lock.
