{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "AUTH_MODE",
        "DATABASE_URL",
        "DAM_STORAGE",
        "DAM_BUCKET",
        "SUPABASE_SECRET_KEY",
        "GOOGLE_OAUTH_CLIENT_ID",
        "GOOGLE_OAUTH_CLIENT_SECRET",
        "GOOGLE_CHAT_WEBHOOK_URL",
        "COMPOSIO_API_KEY",
        "LLM_MONTHLY_CAP_AED",
        "CRON_SECRET",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "DISCOVERY_EXECUTION_ENABLED",
        "DISCOVERY_INTERPRETATION_ENABLED",
        "DISCOVERY_INTERPRETATION_MODEL",
        "DISCOVERY_INTERPRETATION_PRICE_PROOF_JSON",
        "DISCOVERY_N8N_OWNER_EMPLOYEE_ID",
        "DISCOVERY_N8N_CONNECTION_ACCOUNT_ID",
        "DISCOVERY_N8N_WEBHOOK_PATH",
        "DISCOVERY_N8N_TRIGGER_SECRET",
        "DISCOVERY_N8N_CALLBACK_KEYS_JSON",
        "DISCOVERY_REPAIR_SECRET",
        "LLM_PROVIDER",
        "LLM_DEFAULT_MODEL",
        "OPENROUTER_API_KEY",
        "INNGEST_EVENT_KEY",
        "INNGEST_SIGNING_KEY",
        "INNGEST_SERVE_ORIGIN"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
