# Names only — copy to apps/web/.env.local for local Next.js
# See docs/BUILD-ACCESS-INVENTORY.md — never commit real keys
AUTH_MODE=dev
ALLOW_DEV_AUTH=false
NEXT_PUBLIC_APP_URL=https://hrmny-os.vercel.app
NEXT_PUBLIC_PORTAL_URL=https://hrmny-os.vercel.app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=
WORK_ENVIRONMENT_KIND=production
WORK_ENVIRONMENT_ID=hrmny-production
WORK_ENVIRONMENT_VERIFICATION_TOKEN=
WORK_SANDBOX_BASE_URL=
WORK_SANDBOX_VERIFICATION_TOKEN=
WORK_SANDBOX_ALLOW_RESET=false
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Upstash Redis (optional — @hrmny/cache falls back to in-memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
LLM_PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_WORKSPACE_ID=
OPENROUTER_PRIVILEGED_API_KEY=
OPENROUTER_PRIVILEGED_WORKSPACE_ID=
ANTHROPIC_API_KEY=
# Embeddings (memory pipeline) — server only. none|openai|openrouter|local
OPENAI_API_KEY=
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=text-embedding-3-small
ALLOW_LOCAL_EMBEDDINGS=false
OLLAMA_BASE_URL=
# Prefer a free OpenRouter route for demos (content-bearing).
# Default: stealth/ox-alpha ($0 on OpenRouter). Paid models are rejected at runtime.
LLM_DEFAULT_MODEL=stealth/ox-alpha
LLM_REASONING_MODEL=
LLM_ROUTE_MODEL=
LLM_MONTHLY_CAP_AED=1500
COMPOSIO_API_KEY=
COMPOSIO_WEBHOOK_SECRET=
# Client lock: read/mirror only — never set XERO_WRITE_ENABLED=true without new scope
XERO_MODE=mock
XERO_WRITE_ENABLED=false
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=
XERO_WEBHOOK_KEY=
HRMNY_TAX_REGISTRATION_NUMBER=
APOLLO_MODE=mock
APOLLO_API_KEY=
APOLLO_ALLOW_PAID_OPERATIONS=false
HUNTER_MODE=mock
HUNTER_API_KEY=
HUNTER_ALLOW_PAID_OPERATIONS=false
NEVERBOUNCE_API_KEY=
NEVERBOUNCE_ALLOW_PAID_OPERATIONS=false
BAYZAT_SOURCE=csv
# Reserved; API mode remains disabled until tenant-specific official docs exist.
BAYZAT_API_KEY=
BAYZAT_API_BASE_URL=
# n8n — hrmny Cloud only (https://hrmny.app.n8n.cloud). Never commit real keys.
N8N_BASE_URL=https://hrmny.app.n8n.cloud
N8N_API_KEY=
N8N_MODE=mock
N8N_ALLOW_PRODUCTION_TRIGGER=false
N8N_OUTBOUND_WEBHOOK_SECRET=
N8N_WEBHOOK_DEAL_WON=https://hrmny.app.n8n.cloud/webhook/hrmny-deal-won
N8N_WEBHOOK_TICKET_CREATED=https://hrmny.app.n8n.cloud/webhook/hrmny-ticket-created
N8N_WEBHOOK_ERROR_ALERT=https://hrmny.app.n8n.cloud/webhook/hrmny-error-alert
N8N_WEBHOOK_TICKET_TRIAGE=https://hrmny.app.n8n.cloud/webhook/hrmny-ticket-triage-assist
N8N_WEBHOOK_OUTREACH_DRAFT=https://hrmny.app.n8n.cloud/webhook/hrmny-outreach-draft
N8N_WEBHOOK_SECRET=
GOOGLE_CHAT_WEBHOOK_URL=
# Dedicated GBrain runtime; never point this app or QM at GBrain's raw database.
GBRAIN_MCP_URL=
GBRAIN_ACCESS_TOKEN=
GBRAIN_SOURCE_ID=hrmny-os
DAM_STORAGE=memory
DAM_BUCKET=hrmny-dam
DAM_SIGNED_URL_TTL_SECONDS=300
LOG_LEVEL=info
CRON_SECRET=
FEATURE_MINIMAL_HR=true
FEATURE_SHOW_ESS=false
FEATURE_SHOW_BENEFITS=false
FEATURE_SHOW_WORKPLACE=false
FEATURE_SHOW_DIGITAL_CARDS=false
FEATURE_SHOW_DEMO_RESETS=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must be allow-listed on the same Google Cloud OAuth client used for refresh.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google-workspace/callback
GOOGLE_WORKSPACE_REDIRECT_URI=
# Dedicated state secret, at least 32 characters.
GOOGLE_OAUTH_STATE_SECRET=
SUPABASE_JWT_SECRET=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
AGENT_DISABLED_LIST=
LLM_EMBED_MODEL=
LLM_IMAGE_MODEL=
EMAIL_VERIFICATION_PROVIDER=hunter
NEVERBOUNCE_MODE=mock
# Dedicated state secret, at least 32 characters.
XERO_OAUTH_STATE_SECRET=
XERO_ACCESS_TOKEN=
XERO_TENANT_ID=
RESEND_MODE=mock
RESEND_API_KEY=
RESEND_FROM=
HRMNY_N8N_WEBHOOK_SECRET=
LEADGEN_COMPETITORS=
ADS_INSIGHTS_MODE=mock
ADS_INSIGHTS_PLATFORM=meta
